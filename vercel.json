{
  "builds": [
    { "src": "api/analyze.py", "use": "@vercel/python" },
    { "src": "api/explain.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/analyze", "dest": "api/analyze.py" },
    { "src": "/api/explain", "dest": "api/explain.py" },
    { "src": "/$", "dest": "public/index.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
